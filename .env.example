# Universal Groq AI Framework Configuration
# Enter your Groq API keys separated by commas for multi-key rotation & failover
GROQ_API_KEYS=gsk_your_key_1,gsk_your_key_2,gsk_your_key_3

# Default Rotation Strategy: smart-adaptive | round-robin | failover-sequential | least-used
DEFAULT_STRATEGY=smart-adaptive

# Default Model
DEFAULT_MODEL=qwen/qwen3.8-27b

# Server Port & Host
PORT=8000
HOST=0.0.0.0
